# ============================================================
# ARACHNID — AI Provider Configuration
#
# The app runs in two modes:
#
#   DEMO MODE (default)  — no keys required. The built-in Lore
#   Engine answers every request from a local knowledge base
#   with simulated streaming. Perfect for GitHub Pages / demos.
#
#   AI MODE — set at least one provider key below and the app
#   automatically upgrades to real LLM responses with RAG
#   retrieval, citations and streaming.
#
# Providers are tried in order: OPENAI -> ANTHROPIC -> GEMINI.
# ============================================================

# --- Model selection -------------------------------------------------
VITE_AI_PROVIDER=auto            # auto | openai | anthropic | gemini
VITE_AI_MODEL=                   # optional override, e.g. gpt-4o

# --- OpenAI -----------------------------------------------------------
# VITE_OPENAI_API_KEY=sk-...
# VITE_OPENAI_MODEL=gpt-4o

# --- Anthropic ---------------------------------------------------------
# VITE_ANTHROPIC_API_KEY=sk-ant-...
# VITE_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Google Gemini -----------------------------------------------------
# VITE_GEMINI_API_KEY=AIza...
# VITE_GEMINI_MODEL=gemini-2.0-flash

# --- GitHub API (optional; public repos work without a token) ----------
# VITE_GITHUB_TOKEN=ghp_...        # raises rate limits 60 -> 5000/hr
VITE_GITHUB_REPO=CodesbyRohit/spiderman1

# --- Feature toggles ---------------------------------------------------
VITE_ENABLE_VOICE=true            # Web Speech API assistant
VITE_ENABLE_SOUND_DEFAULT=true    # start ambient sound after user gesture
